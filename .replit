modules = ["nodejs-24"]
run = "node server.js"
entrypoint = "server.js"

[deployment]
run = ["node", "server.js"]
build = ["node", "--check", "server.js"]
deploymentTarget = "vm"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Chef on Board"

[[workflows.workflow]]
name = "Chef on Board"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node server.js"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
expertMode = true

[[ports]]
localPort = 3000
externalPort = 80
